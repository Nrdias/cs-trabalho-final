{
  "id": "sarc-realm",
  "realm": "sarc-realm",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrator with full access"
      },
      {
        "name": "PROFESSOR",
        "description": "Professor with booking permissions"
      },
      {
        "name": "ALUNO",
        "description": "Student with read-only view"
      }
    ]
  },
  "clients": [
    {
      "clientId": "sarc-web-react",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],

      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "sarc-gateway",
      "enabled": true,
      "secret": "sarc-gateway-secret-123456",
      "bearerOnly": false,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "natan.admin",
      "enabled": true,
      "email": "natan.admin@sarc.edu",
      "firstName": "Natan",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ]
    },
    {
      "username": "natan.prof",
      "enabled": true,
      "email": "natan.prof@sarc.edu",
      "firstName": "Natan",
      "lastName": "Professor",
      "credentials": [
        {
          "type": "password",
          "value": "professor",
          "temporary": false
        }
      ],
      "realmRoles": [
        "PROFESSOR"
      ]
    },
    {
      "username": "natan",
      "enabled": true,
      "email": "natan@sarc.edu",
      "firstName": "Natan",
      "lastName": "Aluno",
      "credentials": [
        {
          "type": "password",
          "value": "aluno",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ALUNO"
      ]
    }
  ]
}
