{
  "id": "sarc-realm",
  "realm": "sarc-realm",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrator with full access"
      },
      {
        "name": "PROFESSOR",
        "description": "Professor with booking permissions"
      },
      {
        "name": "ALUNO",
        "description": "Student with read-only view"
      }
    ]
  },
  "clients": [
    {
      "clientId": "sarc-web-react",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],

      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "sarc-gateway",
      "enabled": true,
      "secret": "sarc-gateway-secret-123456",
      "bearerOnly": false,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ]
}
